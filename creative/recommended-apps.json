  "adbCommands": [
    {
      "name": {
        "en": "Set Aerial Views Screensaver",
        "he": "הגדרת שומר המסך Aerial Views"
      },
      "command1": "pm path --user current com.neilturner.aerialviews | grep -q '^package:' || { echo 'Install Aerial Views first, then run Set Screensaver again.'; exit 1; }",
      "command2": "settings --user current put secure screensaver_components com.neilturner.aerialviews/.ui.screensaver.DreamActivity",
      "command3": "settings --user current put secure screensaver_activate_on_sleep 1 && settings --user current put secure screensaver_enabled 1",
      "command4": "settings --user current put system screen_off_timeout 300000 && echo 'Aerial Views selected. Screensaver delay: 5 minutes.'"
    },
    {
      "name": {
        "en": "Never turn off when inactive",
        "he": "ביטול כיבוי אוטומטי בחוסר פעילות"
      },
      "command": "settings --user current put secure sleep_timeout -1 && test \"$(settings --user current get secure sleep_timeout)\" = -1 && echo 'Automatically turn off when inactive: Never'"
    },
    {
      "name": {
        "en": "Add keyboard language",
        "he": "הוסף שפה למקלדת"
      },
      "command": "am start -a android.settings.SLICE_SETTINGS -p com.android.tv.settings --es slice_uri content://com.google.android.inputmethod.latin.tv.sliceprovider/language_settings"
    }
  ]
